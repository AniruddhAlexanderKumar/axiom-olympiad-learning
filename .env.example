# ---------------------------------------------------------------------------
# API (server/) - copy to .env at the repo root or in server/
# ---------------------------------------------------------------------------
PORT=4000

# Leave DATABASE_URL empty to run the API on an embedded PGlite database
# (persisted in server/.data/pglite). Set it to a PostgreSQL URL in production;
# Render's blueprint does this for you.
DATABASE_URL=

# TLS for Postgres. Detected automatically (Render's external URLs need it, its
# internal hostname and localhost do not), so only set it to override.
DATABASE_SSL=

# Signing key for session tokens. Required when NODE_ENV=production.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Judge0 code execution. Self-hosted (docker compose up) or RapidAPI.
# Student code is never executed on the API server.
JUDGE0_URL=http://localhost:2358
JUDGE0_KEY=
# Only for the hosted RapidAPI flavour of Judge0:
JUDGE0_HOST=

# Public origin of the deployment, e.g. https://zumi.onrender.com. Render sets
# RENDER_EXTERNAL_URL automatically, so this is only needed on other hosts.
PUBLIC_URL=

# Comma separated browser origins allowed to call the API. Requests from the
# origin that serves the web client and from PUBLIC_URL are already allowed.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006

# Where the exported web client lives (app/dist). Detected automatically.
WEB_DIR=
# Where the content/ JSON lives. Detected automatically.
CONTENT_DIR=

# ---------------------------------------------------------------------------
# Expo app (app/)
# ---------------------------------------------------------------------------
# Base URL of the API. Use "/" when the API serves the web client on the same
# origin (what `npm run build && npm start` and Render do). On a physical device
# use your computer's LAN address.
EXPO_PUBLIC_API_URL=http://localhost:4000
