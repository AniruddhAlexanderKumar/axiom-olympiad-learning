# ---------------------------------------------------------------------------
# API (server/)
# ---------------------------------------------------------------------------
PORT=4000

# Leave DATABASE_URL empty to run the API on an embedded PGlite database
# (persisted in .data/pglite). Point it at PostgreSQL for real deployments.
DATABASE_URL=

# Signing key for session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Judge0 code execution. Self-hosted (docker compose up) or RapidAPI.
# Student code is never executed on the API server.
JUDGE0_URL=http://localhost:2358
JUDGE0_KEY=
# Only for the hosted RapidAPI flavour of Judge0:
JUDGE0_HOST=

# Google sign-in: the Web client ID from Google Cloud console.
GOOGLE_CLIENT_ID=

# Comma separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006

# ---------------------------------------------------------------------------
# Expo app (app/)
# ---------------------------------------------------------------------------
# Base URL of the API. On a physical device use your computer's LAN address.
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
